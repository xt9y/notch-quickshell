#!/usr/bin/env bash

set -euo pipefail

if (( EUID != 0 )); then
    echo "notch-wallpaper-root must run as root" >&2
    exit 1
fi

CALLER="${SUDO_USER:-}"
if [[ -z "$CALLER" || "$CALLER" == "root" ]]; then
    echo "missing unprivileged caller" >&2
    exit 2
fi

if [[ "${1:-}" == "--probe" ]]; then
    exit 0
fi

WALLPAPER="${1:-}"
if [[ -z "$WALLPAPER" ]]; then
    echo "missing wallpaper" >&2
    exit 2
fi

HOME_DIR="$(getent passwd "$CALLER" | cut -d: -f6)"
if [[ -z "$HOME_DIR" ]]; then
    echo "could not resolve caller home" >&2
    exit 2
fi

WALLPAPER="$(readlink -f -- "$WALLPAPER")"
WALLPAPER_DIR="$(readlink -f -- "$HOME_DIR/.config/quickshell/notch/wallpaper")"

if [[ ! -f "$WALLPAPER" || "$(dirname -- "$WALLPAPER")" != "$WALLPAPER_DIR" ]]; then
    echo "wallpaper must be a regular file directly inside the notch wallpaper directory" >&2
    exit 3
fi

EXT="${WALLPAPER##*.}"
EXT="${EXT,,}"
if [[ "$EXT" != "jpg" && "$EXT" != "png" ]]; then
    echo "only .jpg and .png are allowed" >&2
    exit 3
fi

TMP="$(mktemp /tmp/notch-wallpaper.XXXXXX)"
trap 'rm -f -- "$TMP"' EXIT

if command -v runuser >/dev/null 2>&1; then
    runuser -u "$CALLER" -- cat -- "$WALLPAPER" > "$TMP"
else
    sudo -u "$CALLER" -- cat -- "$WALLPAPER" > "$TMP"
fi

DEST="/var/lib/plasmalogin/wallpapers/login-wallpaper.${EXT}"

mkdir -p /var/lib/plasmalogin/wallpapers
rm -f /var/lib/plasmalogin/wallpapers/login-wallpaper.jpg \
      /var/lib/plasmalogin/wallpapers/login-wallpaper.png
cp -- "$TMP" "$DEST"
chmod 0644 "$DEST"

if [[ -f /etc/plasmalogin.conf ]]; then
    sed -i "s|Image=.*|Image=file://${DEST}|" /etc/plasmalogin.conf
fi

mkdir -p /usr/local/share/wallpapers
cp -- "$TMP" /usr/local/share/wallpapers/login-wallpaper.jpg
chmod 0644 /usr/local/share/wallpapers/login-wallpaper.jpg
